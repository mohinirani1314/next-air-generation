// From component hook.txt (Backend integration & mutations)
export function useAddAirQuality() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: async (record: Omit<AirQualityRecord, "id">) => {
      const { error: aqError } = await supabase.from("air_quality").insert({
        city: record.city,
        aqi: record.aqi,
        co: record.co,
        no2: record.no2,
        so2: record.so2,
        pm25: record.pm25,
        pm10: record.pm10,
      });
      if (aqError) throw aqError;

      // Server-side logic execution: Auto-generate health alert if AQI > 100
      if (record.aqi > 100) {
        const cat = getAqiCategory(record.aqi);
        await supabase.from("health_alerts").insert({
          city: record.city,
          aqi: record.aqi,
          alert_message: cat.description,
          severity: cat.severity,
        });
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["air-quality"] });
      queryClient.invalidateQueries({ queryKey: ["health-alerts"] });
    },
  });
}
